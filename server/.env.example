DEBUG=True
#tem que ser IDÊNTICA a SECRET_KEY do backend/.env do HUB
SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1

# nomes dos cookies do HUB — têm que bater com os valores do hub
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# base da API do HUB pra chamadas servidor-a-servidor
HUB_BASE_URL=http://localhost:8000

# origens que podem chamar esta API com cookie
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001,http://127.0.0.1:8001

# Registro deste sistema no HUB
# Cada dev cadastra o proprio "Sistema-de-Bolsistas" no HUB local (precisa ser admin) e cola aqui o que o HUB gerar
# Não dá pra reaproveitar os valores de outra pessoa
# cada HUB local tem seu próprio banco
HUB_SYSTEM_ID=
HUB_SYSTEM_NAME=Sistema-de-Bolsistas
HUB_SYSTEM_URL=http://localhost:8001
HUB_SYSTEM_API_KEY=
# Pode ser a mesma SECRET_KEY de cima é só o campo "Secret Key" do formulário de cadastro do sistema no HUB não é usado pra validar nada
HUB_SYSTEM_SECRET_KEY=

# Coordenadores de Área
COORDENADOR_ENSINO_EMAIL=
COORDENADOR_PESQUISA_EMAIL=
COORDENADOR_EXTENSAO_EMAIL=
